# Local development only (`pnpm dev`). Public values, safe to commit.
# The report form posts to /api/report; Vite proxies it to `pnpm report:dev` (dry run).
VITE_REPORT_ENDPOINT=/api/report
# Cloudflare Turnstile test key: always passes, works on any host.
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
VITE_GITHUB_REPO=patrikliska/kingdoms-wiki
